\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Spearman $\rho (\texttt  {tokens\_generated}, \text  {signal})$ per cell on closed-book traces. Bold: $|\rho | \geq 0.5$. The peer-pool signals (DRAGIN, ent.max, etc, flare.max, u\_cons.max, seakr\_k5) carry $\rho \in [+0.26, +0.46]$, \texttt  {hvr.max} reaches $+0.51$ on Gemma$\times $2Wiki, and the auxiliary hidden-state geometry diagnostics span $\rho \in [-0.07, +0.36]$. The answer-trajectory aggregations (bottom block) average $\approx 0.15$ lower in $|\rho |$ than the peer-pool block, the per-cell quantitative version of the family-level finding from \S  \ref {sec:results-matrix}. $^{\ast }$Qwen$\times $Hot \texttt  {hvr.max} is constant, so Spearman is undefined.}}{10}{table.caption.28}\protected@file@percent }
\newlabel{tab:spearman}{{7}{10}{Spearman $\rho (\texttt {tokens\_generated}, \text {signal})$ per cell on closed-book traces. Bold: $|\rho | \geq 0.5$. The peer-pool signals (DRAGIN, ent.max, etc, flare.max, u\_cons.max, seakr\_k5) carry $\rho \in [+0.26, +0.46]$, \texttt {hvr.max} reaches $+0.51$ on Gemma$\times $2Wiki, and the auxiliary hidden-state geometry diagnostics span $\rho \in [-0.07, +0.36]$. The answer-trajectory aggregations (bottom block) average $\approx 0.15$ lower in $|\rho |$ than the peer-pool block, the per-cell quantitative version of the family-level finding from \S \ref {sec:results-matrix}. $^{\ast }$Qwen$\times $Hot \texttt {hvr.max} is constant, so Spearman is undefined}{table.caption.28}{}}
