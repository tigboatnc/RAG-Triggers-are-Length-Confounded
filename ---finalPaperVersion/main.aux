\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces $\varepsilon _{\text  {protocol}} = |\text  {ours}_{\text  {resid}} - \text  {LINE}_{\text  {full}}|$; $\varepsilon _{\text  {sampling}} = |\text  {LINE}_{\text  {full}} - \text  {LINE}_{\text  {split}}|$ (latter averaged over 3 seeds). Both architectures show $\varepsilon _{\text  {protocol}} \leq 0.029$, well below the conventional threshold of $0.05$. Train/test sampling noise ($\varepsilon _{\text  {sampling}}$) dominates the protocol gap by a factor of $3$--$4\times $, indicating that the $\log (\texttt  {tokens}+1)$ vs.\ raw-MinMax math difference is small relative to evaluation-set variance at $n{=}200$.}}{9}{table.caption.26}\protected@file@percent }
\newlabel{tab:uline-repl}{{5}{9}{$\varepsilon _{\text {protocol}} = |\text {ours}_{\text {resid}} - \text {LINE}_{\text {full}}|$; $\varepsilon _{\text {sampling}} = |\text {LINE}_{\text {full}} - \text {LINE}_{\text {split}}|$ (latter averaged over 3 seeds). Both architectures show $\varepsilon _{\text {protocol}} \leq 0.029$, well below the conventional threshold of $0.05$. Train/test sampling noise ($\varepsilon _{\text {sampling}}$) dominates the protocol gap by a factor of $3$--$4\times $, indicating that the $\log (\texttt {tokens}+1)$ vs.\ raw-MinMax math difference is small relative to evaluation-set variance at $n{=}200$}{table.caption.26}{}}
