\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Operational differences across three concurrent commitment-time primitives. \citet  {datta_large_2026}'s $t^\star $ is backward-looking on per-step intermediate answers, applied to early stopping. \citet  {zhang_when_2026}'s $\tau _{\text  {commit}}$ is forward-looking on the model's finite-answer continuation distribution (log-odds in binary tasks), applied to pre-verbalization commitment analysis. FCT (ours) is forward-looking on $K{=}5$-majority answer extracts, applied to retrieval triggering. For monotonically converging trajectories, $t_{\text  {commit}} \approx t^\star + 1$; under $K{=}5$ majority sampling on non-thinking-mode chat models this equivalence does not hold in general.}}{10}{table.caption.27}\protected@file@percent }
\newlabel{tab:fct-vs-tstar}{{6}{10}{Operational differences across three concurrent commitment-time primitives. \citet {datta_large_2026}'s $t^\star $ is backward-looking on per-step intermediate answers, applied to early stopping. \citet {zhang_when_2026}'s $\tau _{\text {commit}}$ is forward-looking on the model's finite-answer continuation distribution (log-odds in binary tasks), applied to pre-verbalization commitment analysis. FCT (ours) is forward-looking on $K{=}5$-majority answer extracts, applied to retrieval triggering. For monotonically converging trajectories, $t_{\text {commit}} \approx t^\star + 1$; under $K{=}5$ majority sampling on non-thinking-mode chat models this equivalence does not hold in general}{table.caption.27}{}}
