\providecommand\NAT@force@numbers{}\NAT@force@numbers
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Phase 1.3: KV-pressure on Qwen3.6-35B-A3B alone is essentially flat at $5{,}000$ tokens of decode.} Top: VRAM allocated (GiB) over tokens generated. Bottom: rolling tok/s over a $500$-token window. Three prompt classes (factual, multi-hop, ambiguous) overlaid, indistinguishable. Total VRAM growth across the $5\,000$-token run is ${\sim } 80$~MB; per-token decode latency is flat or slightly decreasing (step~5000 is $\sim 2\%$ faster than step~1). This is the result that triggered the cognitive-efficiency reframing in~\S  \ref {sec:intro}: on this generator, at this context length, KV pressure is not the binding cost. }}{21}{figure.caption.18}\protected@file@percent }
\newlabel{fig:phase1.3}{{1}{21}{\textbf {Phase 1.3: KV-pressure on Qwen3.6-35B-A3B alone is essentially flat at $5{,}000$ tokens of decode.} Top: VRAM allocated (GiB) over tokens generated. Bottom: rolling tok/s over a $500$-token window. Three prompt classes (factual, multi-hop, ambiguous) overlaid, indistinguishable. Total VRAM growth across the $5\,000$-token run is ${\sim } 80$~MB; per-token decode latency is flat or slightly decreasing (step~5000 is $\sim 2\%$ faster than step~1). This is the result that triggered the cognitive-efficiency reframing in~\S \ref {sec:intro}: on this generator, at this context length, KV pressure is not the binding cost}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {Phase 1.4 headline: KV-pressure across three architectural classes, normalized to the step-500 baseline.} Mean across $3$ prompt classes ($\pm 1\sigma $ ribbons; very thin because prompt-class variance is tiny — see Tab.~\ref {tab:phase1.4}). Phi-4-mini shows $\sim 128$ KB/token clean linear growth — the steep reference. Gemma 4 26B A4B shows $\sim 221$ KB/token linear growth, \emph  {steeper than Phi}, contrary to our pre-experiment prediction (we expected a knee at the $1024$-token sliding-window cap; in HF \texttt  {DynamicCache} no such eviction occurs, see text). Qwen3.6-35B-A3B shows $\sim 27$ KB/token, near-flat. }}{22}{figure.caption.21}\protected@file@percent }
\newlabel{fig:phase1.4-bracketing}{{2}{22}{\textbf {Phase 1.4 headline: KV-pressure across three architectural classes, normalized to the step-500 baseline.} Mean across $3$ prompt classes ($\pm 1\sigma $ ribbons; very thin because prompt-class variance is tiny — see Tab.~\ref {tab:phase1.4}). Phi-4-mini shows $\sim 128$ KB/token clean linear growth — the steep reference. Gemma 4 26B A4B shows $\sim 221$ KB/token linear growth, \emph {steeper than Phi}, contrary to our pre-experiment prediction (we expected a knee at the $1024$-token sliding-window cap; in HF \texttt {DynamicCache} no such eviction occurs, see text). Qwen3.6-35B-A3B shows $\sim 27$ KB/token, near-flat}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textbf  {Phase 2.1 (last-layer): the latent-state signal exists on every architectural class — but the magnitude differs by $20\times $ on $\mathrm  {drift}_{\cos }$ and by $200\times $ on $\operatorname  {Var}^{(W)}$.} Bars are mean over the trace post step~1 (drift is zero by definition at step~1); error bars are $\pm 1\sigma $ across the three prompt classes. Phi-4-mini's signal is in the $\sim 0.02$ regime; Qwen3.6's is in the $\sim 0.5$ regime, near the saturation end of cosine distance. We attribute the per-architecture scale difference to MoE expert-routing-induced last-layer-hidden-state variability (\S  \ref {sec:phase2-l1}). }}{23}{figure.caption.27}\protected@file@percent }
\newlabel{fig:phase2-summary}{{3}{23}{\textbf {Phase 2.1 (last-layer): the latent-state signal exists on every architectural class — but the magnitude differs by $20\times $ on $\drift $ and by $200\times $ on $\Var ^{(W)}$.} Bars are mean over the trace post step~1 (drift is zero by definition at step~1); error bars are $\pm 1\sigma $ across the three prompt classes. Phi-4-mini's signal is in the $\sim 0.02$ regime; Qwen3.6's is in the $\sim 0.5$ regime, near the saturation end of cosine distance. We attribute the per-architecture scale difference to MoE expert-routing-induced last-layer-hidden-state variability (\S \ref {sec:phase2-l1})}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  \textbf  {Cosine drift between consecutive CRVs ($\mathrm  {drift}_{\cos }_i$, Eq.~\ref {eq:drift}) over the 5\,000-token trace, last-layer.} Three rows, one per architectural class. Three line styles per row, one per prompt class. \textbf  {Phi-4-mini} (top, blue): drift mostly in $[0, 0.05]$, with occasional event-like spikes to $\sim 0.2$. We highlight the cluster around $T \approx 4000$ in factual / multi-hop traces — these correspond to model-side phase transitions visible in the generated text (end of a historical period, transition from in-trace reasoning to summary). \textbf  {Gemma 4 26B A4B} (middle, orange): drift in $[0.0, 0.5]$ with no clean baseline; traces are dense and noisy. Note the multi-hop trace is much shorter on the x-axis because it produces only $52$ logical steps (Tab.~\ref {tab:phase2-density}). \textbf  {Qwen3.6-35B-A3B} (bottom, green): drift consistently in $[0.3, 0.8]$ across the full $5\,000$-token trace; near-saturated. We attribute this to MoE-routing variance dominating the last-layer hidden state. }}{24}{figure.caption.28}\protected@file@percent }
\newlabel{fig:phase2-drift}{{4}{24}{\textbf {Cosine drift between consecutive CRVs ($\drift _i$, Eq.~\ref {eq:drift}) over the 5\,000-token trace, last-layer.} Three rows, one per architectural class. Three line styles per row, one per prompt class. \textbf {Phi-4-mini} (top, blue): drift mostly in $[0, 0.05]$, with occasional event-like spikes to $\sim 0.2$. We highlight the cluster around $T \approx 4000$ in factual / multi-hop traces — these correspond to model-side phase transitions visible in the generated text (end of a historical period, transition from in-trace reasoning to summary). \textbf {Gemma 4 26B A4B} (middle, orange): drift in $[0.0, 0.5]$ with no clean baseline; traces are dense and noisy. Note the multi-hop trace is much shorter on the x-axis because it produces only $52$ logical steps (Tab.~\ref {tab:phase2-density}). \textbf {Qwen3.6-35B-A3B} (bottom, green): drift consistently in $[0.3, 0.8]$ across the full $5\,000$-token trace; near-saturated. We attribute this to MoE-routing variance dominating the last-layer hidden state}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  \textbf  {Rolling L2-norm variance ($\operatorname  {Var}_i^{(10)}$, Eq.~\ref {eq:variance}) over the 5\,000-token trace, last-layer.} Same row order and line-style mapping as Figure~\ref {fig:phase2-drift}. The Phi panel (top) shows a strong event-driven structure — long quiet baselines punctuated by sharp spikes, e.g.~the spike at $T \approx 4\,000$ in factual / multi-hop traces. The Gemma panel shows both spikes and a slowly rising envelope. The Qwen panel shows fluctuating but persistent noise. }}{25}{figure.caption.29}\protected@file@percent }
\newlabel{fig:phase2-variance}{{5}{25}{\textbf {Rolling L2-norm variance ($\Var _i^{(10)}$, Eq.~\ref {eq:variance}) over the 5\,000-token trace, last-layer.} Same row order and line-style mapping as Figure~\ref {fig:phase2-drift}. The Phi panel (top) shows a strong event-driven structure — long quiet baselines punctuated by sharp spikes, e.g.~the spike at $T \approx 4\,000$ in factual / multi-hop traces. The Gemma panel shows both spikes and a slowly rising envelope. The Qwen panel shows fluctuating but persistent noise}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  \textbf  {Cosine drift over 5\,000 tokens, mid-stack mitigation.} Same row-and-line-style layout as Figure~\ref {fig:phase2-drift}. \textbf  {Phi-4-mini} (top): qualitatively similar to last-layer, slightly more reactive; sharp spikes at $T \approx 1\,500$, $\approx 4{,}100$, and $\approx 4{,}500$ (factual). \textbf  {Gemma 4 26B A4B} (middle): two large clean spikes ($\mathrm  {drift}_{\cos }\approx 1.0$ and $\approx 1.25$) at $T \approx 1{,}500$ and $T \approx 4{,}700$ on the factual trace, where the last-layer was masked by routing noise — these are informative events that mid-stack reveals. \textbf  {Qwen3.6-35B-A3B} (bottom): drift no longer saturated; range $0.0$--$0.7$ with visible per-trace structure including a clean drop in the multi-hop trace's tail. }}{26}{figure.caption.36}\protected@file@percent }
\newlabel{fig:phase2-drift-mid}{{6}{26}{\textbf {Cosine drift over 5\,000 tokens, mid-stack mitigation.} Same row-and-line-style layout as Figure~\ref {fig:phase2-drift}. \textbf {Phi-4-mini} (top): qualitatively similar to last-layer, slightly more reactive; sharp spikes at $T \approx 1\,500$, $\approx 4{,}100$, and $\approx 4{,}500$ (factual). \textbf {Gemma 4 26B A4B} (middle): two large clean spikes ($\drift \approx 1.0$ and $\approx 1.25$) at $T \approx 1{,}500$ and $T \approx 4{,}700$ on the factual trace, where the last-layer was masked by routing noise — these are informative events that mid-stack reveals. \textbf {Qwen3.6-35B-A3B} (bottom): drift no longer saturated; range $0.0$--$0.7$ with visible per-trace structure including a clean drop in the multi-hop trace's tail}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  \textbf  {Phase 2 mid-stack signal summary.} Same layout as Figure~\ref {fig:phase2-summary}. Contrast: drift magnitudes have converged across architectures (Phi $0.033$, Gemma $0.106$, Qwen $0.235$ — within one order of magnitude rather than 20 as at last-layer), while variance now bifurcates with Qwen's L2-norm variance collapsing to $0.09$ (essentially constant L2; the recurrent DeltaNet state's spectral structure is preserved through the mid-stack). The bar plot makes explicit that the trigger-feature choice should be \emph  {per-architecture}: drift carries the signal universally, variance is informative on Phi and Gemma but uninformative on Qwen at mid-stack. }}{27}{figure.caption.37}\protected@file@percent }
\newlabel{fig:phase2-summary-mid}{{7}{27}{\textbf {Phase 2 mid-stack signal summary.} Same layout as Figure~\ref {fig:phase2-summary}. Contrast: drift magnitudes have converged across architectures (Phi $0.033$, Gemma $0.106$, Qwen $0.235$ — within one order of magnitude rather than 20 as at last-layer), while variance now bifurcates with Qwen's L2-norm variance collapsing to $0.09$ (essentially constant L2; the recurrent DeltaNet state's spectral structure is preserved through the mid-stack). The bar plot makes explicit that the trigger-feature choice should be \emph {per-architecture}: drift carries the signal universally, variance is informative on Phi and Gemma but uninformative on Qwen at mid-stack}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  \textbf  {Rolling L2-norm variance over $5\,000$ tokens, mid-stack mitigation.} Same row-and-line-style layout as Figure~\ref {fig:phase2-variance}. \textbf  {Phi} (top): the strong event spike at $T \approx 4{,}000$ in the factual / multi-hop traces is preserved with sharper peak (max ${\sim }120$ vs ${\sim }45$ at last-layer); the rest of the trace is a flat baseline. \textbf  {Gemma} (middle): a slowly rising multi-hop variance envelope is visible (dashed orange), and the factual / ambiguous traces show step-like structure rather than the noisy continuum at last-layer (the trace absolute scale is also much smaller, $\sim 0$--$700$ vs $\sim 0$--$1500$). \textbf  {Qwen} (bottom): the variance of L2 norm has collapsed to the $0$--$0.35$ range, four orders of magnitude smaller than last-layer. This confirms that \emph  {the per-token L2-norm of the mid-stack representation is essentially constant on Qwen3.6}; whatever signal exists at mid-stack lives in directional change ($\mathrm  {drift}_{\cos }$), not in norm fluctuation. }}{28}{figure.caption.38}\protected@file@percent }
\newlabel{fig:phase2-variance-mid}{{8}{28}{\textbf {Rolling L2-norm variance over $5\,000$ tokens, mid-stack mitigation.} Same row-and-line-style layout as Figure~\ref {fig:phase2-variance}. \textbf {Phi} (top): the strong event spike at $T \approx 4{,}000$ in the factual / multi-hop traces is preserved with sharper peak (max ${\sim }120$ vs ${\sim }45$ at last-layer); the rest of the trace is a flat baseline. \textbf {Gemma} (middle): a slowly rising multi-hop variance envelope is visible (dashed orange), and the factual / ambiguous traces show step-like structure rather than the noisy continuum at last-layer (the trace absolute scale is also much smaller, $\sim 0$--$700$ vs $\sim 0$--$1500$). \textbf {Qwen} (bottom): the variance of L2 norm has collapsed to the $0$--$0.35$ range, four orders of magnitude smaller than last-layer. This confirms that \emph {the per-token L2-norm of the mid-stack representation is essentially constant on Qwen3.6}; whatever signal exists at mid-stack lives in directional change ($\drift $), not in norm fluctuation}{figure.caption.38}{}}
