\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Length-orthogonal trigger signals on the headline pool.} Paired-bootstrap forest plot of $\Delta = \mathrm  {AUROC}(s_{\text  {resid}}) - \mathrm  {AUROC}(\texttt  {tokens\_generated})$ for the 17 audited signals on the Qwen2.5-7B + Gemma-4-26B-A4B headline pool ($n{=}800$ paired traces, $\texttt  {lift\_em}{=}+1$ target, $B{=}10{,}000$). Thick bars are nominal 95\% CIs; thin extensions are Bonferroni-corrected $\sim $99.67\% CIs at $k{=}15$. Vertical dashed line marks the length baseline ($\Delta =0$). Three tiers, separated by horizontal lines and background banding: top four (Bonferroni-robust) are \textbf  {ECT}, DRAGIN-RIND.max, \texttt  {min\_majority}, \texttt  {ent.max} --- spanning four different signal families. Color: \textcolor [HTML]{1f77b4}{blue} $=$ answer-trajectory (Datta-derived); \textcolor [HTML]{d62728}{red} $=$ attention (DRAGIN); \textcolor [HTML]{ff7f0e}{orange} $=$ logit / $K{=}5$-text; \textcolor [HTML]{7f7f7f}{grey} $=$ hidden-state / text. SRC: \texttt  {analysis/e7\_bonferroni.out}, \texttt  {analysis/plot\_survivor\_forest.py}.}}{29}{figure.1}\protected@file@percent }
\newlabel{fig:survivor-forest}{{1}{29}{\textbf {Length-orthogonal trigger signals on the headline pool.} Paired-bootstrap forest plot of $\Delta = \mathrm {AUROC}(s_{\text {resid}}) - \mathrm {AUROC}(\texttt {tokens\_generated})$ for the 17 audited signals on the Qwen2.5-7B + Gemma-4-26B-A4B headline pool ($n{=}800$ paired traces, $\texttt {lift\_em}{=}+1$ target, $B{=}10{,}000$). Thick bars are nominal 95\% CIs; thin extensions are Bonferroni-corrected $\sim $99.67\% CIs at $k{=}15$. Vertical dashed line marks the length baseline ($\Delta =0$). Three tiers, separated by horizontal lines and background banding: top four (Bonferroni-robust) are \textbf {ECT}, DRAGIN-RIND.max, \texttt {min\_majority}, \texttt {ent.max} --- spanning four different signal families. Color: \textcolor [HTML]{1f77b4}{blue} $=$ answer-trajectory (Datta-derived); \textcolor [HTML]{d62728}{red} $=$ attention (DRAGIN); \textcolor [HTML]{ff7f0e}{orange} $=$ logit / $K{=}5$-text; \textcolor [HTML]{7f7f7f}{grey} $=$ hidden-state / text. SRC: \texttt {analysis/e7\_bonferroni.out}, \texttt {analysis/plot\_survivor\_forest.py}}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Cross-architecture survivor matrix} on the headline pool (Qwen2.5-7B-Instruct + Gemma-4-26B-A4B-it $\times $ \{HotpotQA, 2WikiMHQA\}, $n{=}800$ paired traces). All AUROCs are length-residualized via Eq.~(\ref {eq:residualize}). 95\% CIs are paired bootstrap ($B{=}10{,}000$) of $\Delta = \mathrm  {AUROC}(s_{\text  {resid}}) - \mathrm  {AUROC}(\texttt  {tokens\_generated})$. The right-most column gives the Bonferroni-corrected $\sim $99.67\% CI at $k{=}15$ ($\alpha =0.0033$). \textbf  {Nine signals} clear nominal-95\% paired-significance against length; \textbf  {four} survive Bonferroni at $k{=}15$. SRC: \texttt  {analysis/moonshot\_explore\_3arch.out.b10k} (M-series, answer-trajectory, top trigger-pool rows) and \texttt  {analysis/e7\_bonferroni.out} (Bonferroni column, all rows).}}{30}{table.4}\protected@file@percent }
\newlabel{tab:hero}{{4}{30}{\textbf {Cross-architecture survivor matrix} on the headline pool (Qwen2.5-7B-Instruct + Gemma-4-26B-A4B-it $\times $ \{HotpotQA, 2WikiMHQA\}, $n{=}800$ paired traces). All AUROCs are length-residualized via Eq.~(\ref {eq:residualize}). 95\% CIs are paired bootstrap ($B{=}10{,}000$) of $\Delta = \mathrm {AUROC}(s_{\text {resid}}) - \mathrm {AUROC}(\texttt {tokens\_generated})$. The right-most column gives the Bonferroni-corrected $\sim $99.67\% CI at $k{=}15$ ($\alpha =0.0033$). \textbf {Nine signals} clear nominal-95\% paired-significance against length; \textbf {four} survive Bonferroni at $k{=}15$. SRC: \texttt {analysis/moonshot\_explore\_3arch.out.b10k} (M-series, answer-trajectory, top trigger-pool rows) and \texttt {analysis/e7\_bonferroni.out} (Bonferroni column, all rows)}{table.4}{}}
