\newlabel{tab:bonferroni}{{9}{33}{Bonferroni-corrected survivor set on the headline pool (Qwen+Gemma, $n{=}800$ paired, target $\texttt {lift\_em}{=}+1$, $B{=}10{,}000$). SRC: \texttt {analysis/e7\_bonferroni.out}}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Spearman $\rho (\texttt  {tokens\_generated}, \text  {signal})$ per cell, closed-book traces. Bold entries have $|\rho |\geq 0.5$ (Santilli's length-confound threshold). Only one signal-cell ($\mathrm  {hvr.max}\times \text  {Gemma}\times \text  {2Wiki}$, $\rho {=}+0.51$) breaches it. $^{*}$Qwen$\times $Hot $\mathrm  {hvr.max}$ is constant (all zero) and Spearman is undefined. The published trigger pool (top block) carries $\rho \in [+0.18, +0.46]$; the step-level answer-trajectory triggers and moonshot signals (bottom block) carry $\rho \in [+0.09, +0.37]$, on average $\approx 0.1$ AUROC lower in length correlation. SRC: \texttt  {analysis/e7\_spearman.out}.}}{34}{table.10}\protected@file@percent }
\newlabel{tab:spearman}{{10}{34}{Spearman $\rho (\texttt {tokens\_generated}, \text {signal})$ per cell, closed-book traces. Bold entries have $|\rho |\geq 0.5$ (Santilli's length-confound threshold). Only one signal-cell ($\mathrm {hvr.max}\times \text {Gemma}\times \text {2Wiki}$, $\rho {=}+0.51$) breaches it. $^{*}$Qwen$\times $Hot $\mathrm {hvr.max}$ is constant (all zero) and Spearman is undefined. The published trigger pool (top block) carries $\rho \in [+0.18, +0.46]$; the step-level answer-trajectory triggers and moonshot signals (bottom block) carry $\rho \in [+0.09, +0.37]$, on average $\approx 0.1$ AUROC lower in length correlation. SRC: \texttt {analysis/e7\_spearman.out}}{table.10}{}}
