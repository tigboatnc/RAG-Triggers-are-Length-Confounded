\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces $\varepsilon _{\text  {protocol}} = |\text  {ours}_{\text  {resid}} - \text  {LINE}_{\text  {full}}|$; $\varepsilon _{\text  {sampling}} = |\text  {LINE}_{\text  {full}} - \text  {LINE}_{\text  {split}}|$ (the latter averaged over 5 seeds). Both architectures show $\varepsilon _{\text  {protocol}} \leq 0.029$: our protocol matches the reference math within numerical noise. SRC: \texttt  {analysis/uncertainty\_line\_audit\_*.\{out,json\}}.}}{31}{table.7}\protected@file@percent }
